# Copy to .env and fill in. Never commit .env.

# SearXNG (compose service "searxng"): any long random string, e.g. openssl rand -hex 32
SEARXNG_SECRET=

# Local mode (CLI without Docker): where your SearXNG instance answers
SEARXNG_URL=http://127.0.0.1:47880

# Host ports (bound to 127.0.0.1). Change them if they are taken on this machine;
# with SEARXNG_PORT, update SEARXNG_URL above to match (it is only used by the local CLI).
DEEPSIFT_PORT=47800
SEARXNG_PORT=47880

# Optional: raises Gravatar's limits
GRAVATAR_API_KEY=

# TinEye reverse image search (paid API bundle): https://services.tineye.com/TinEyeAPI
TINEYE_API_KEY=

# Telegram (opt-in service, dedicated account): https://my.telegram.org > API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
